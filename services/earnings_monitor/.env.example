# Safe local defaults. Copy to .env.local and point Compose at it for overrides.
APP_ENV=local
LOG_LEVEL=INFO
WORKER_IDLE_SECONDS=10
DASHBOARD_PORT=8501
DATA_DIR=/data
SHADOW_MODE=true

EARNINGS_MONITOR_REPO_ROOT=/app
EARNINGS_MONITOR_DB=/data/monitor.sqlite3
EARNINGS_MONITOR_INBOX=/app/earnings-scraper-main/earnings-scraper-main/inbox
EARNINGS_MONITOR_DATASET=/data/company_quarters.parquet
EARNINGS_MONITOR_TICKERS=AMZN,MSFT,NVDA,AAPL
EARNINGS_MONITOR_PROVIDER=local
EARNINGS_MONITOR_POLL_SECONDS=300
EARNINGS_MONITOR_STABILIZATION_SECONDS=300
EARNINGS_MONITOR_MIN_CHARS=1000
EARNINGS_MONITOR_MAX_ATTEMPTS=3
EARNINGS_MONITOR_WORKFLOW=new_quarter
EARNINGS_MONITOR_SMTP_HOST=mailpit
EARNINGS_MONITOR_SMTP_PORT=1025
EARNINGS_MONITOR_SMTP_FROM=earnings-monitor@localhost
EARNINGS_MONITOR_SMTP_TO=developer@localhost
EARNINGS_MONITOR_SMTP_STARTTLS=false

# AWS values are intentionally blank for local mode.
AWS_REGION=us-east-1
QUEUE_URL=
STATE_TABLE_NAME=
ARTIFACT_BUCKET_NAME=
APP_SECRET_ARN=
SES_IDENTITY_ARN=
