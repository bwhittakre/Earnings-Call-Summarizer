# Safe local defaults. Copy to .env.local and point Compose at it for overrides.
APP_ENV=local
LOG_LEVEL=INFO
WORKER_IDLE_SECONDS=10
DASHBOARD_PORT=8501
DATA_DIR=/data
SHADOW_MODE=true

EARNINGS_MONITOR_REPO_ROOT=/app
EARNINGS_MONITOR_DB=/data/monitor.sqlite3
EARNINGS_MONITOR_INBOX=/app/earnings-scraper-main/earnings-scraper-main/inbox
EARNINGS_MONITOR_DATASET=/data/company_quarters.parquet
EARNINGS_MONITOR_HISTORY_SOURCE=/history-source/output
EARNINGS_MONITOR_REFRESH_HISTORY=true
# After successful post_call, mark Rank IC + consolidated HTML for async regen.
EARNINGS_MONITOR_RESEARCH_REGEN=true
EARNINGS_MONITOR_RESEARCH_REGEN_DEBOUNCE_SECONDS=60
EARNINGS_MONITOR_RESEARCH_REGEN_IDLE_SECONDS=30
EARNINGS_MONITOR_RESEARCH_MIN_CALENDAR_QUARTER=2016-Q2
EARNINGS_MONITOR_RESEARCH_SECTOR=xlk_tech
EARNINGS_MONITOR_TICKERS=AAPL,ACN,ADBE,ADI,ADSK,AMAT,AMZN,APH,AVGO,CRM,CTSH,IBM,INTU,LRCX,MSFT,MU,NVDA,ORCL,SPCX,TEL,TXN
# manual, local, or watched. Local assisted mode uses "watched" so host
# calendar_publish can auto-arm onboarded tickers via *.event.json.
EARNINGS_MONITOR_PROVIDER=watched
EARNINGS_MONITOR_EVENT_MANIFESTS=/app/earnings-scraper-main/earnings-scraper-main/inbox/events
EARNINGS_MONITOR_POLL_SECONDS=300
EARNINGS_MONITOR_STABILIZATION_SECONDS=300
EARNINGS_MONITOR_MIN_CHARS=1000
# LIVE bundles must grow once before the first stagnation score (default true).
EARNINGS_MONITOR_REQUIRE_LIVE_GROWTH=true
EARNINGS_MONITOR_MAX_ATTEMPTS=3
EARNINGS_MONITOR_RETRY_BASE_SECONDS=60
EARNINGS_MONITOR_LEASE_TIMEOUT_SECONDS=3600
EARNINGS_MONITOR_QUANT_START_OFFSET_SECONDS=5400
EARNINGS_MONITOR_TRANSCRIPT_START_DELAY_SECONDS=2700
EARNINGS_MONITOR_TRANSCRIPT_TIMEOUT_SECONDS=10800
EARNINGS_MONITOR_WORKFLOW=new_quarter
EARNINGS_MONITOR_STUCK_EVENT_SECONDS=7200
EARNINGS_MONITOR_REPEATED_FAILURE_THRESHOLD=2
EARNINGS_MONITOR_DASHBOARD_URL=http://localhost:8501
EARNINGS_MONITOR_ARTIFACT_PUBLIC_BASE_URL=
# Local defaults use Mailpit. For Microsoft 365, set mode=microsoft365,
# host=smtp.office365.com, port=587, STARTTLS=true, and provide the tenant-
# approved mailbox credentials/from/to values in an untracked env file.
EARNINGS_MONITOR_SMTP_MODE=local
EARNINGS_MONITOR_SMTP_HOST=mailpit
EARNINGS_MONITOR_SMTP_PORT=1025
EARNINGS_MONITOR_SMTP_USERNAME=
EARNINGS_MONITOR_SMTP_PASSWORD=
EARNINGS_MONITOR_SMTP_FROM=earnings-monitor@localhost
EARNINGS_MONITOR_SMTP_TO=developer@localhost
EARNINGS_MONITOR_SMTP_STARTTLS=false

# Optional Cloudflare edge/storage integration. Leave all values blank for the
# default localhost-only runtime. Never commit real token or key values.
CLOUDFLARE_TUNNEL_TOKEN=
EARNINGS_MONITOR_R2_ACCOUNT_ID=
EARNINGS_MONITOR_R2_ENDPOINT_URL=
EARNINGS_MONITOR_R2_BUCKET=
EARNINGS_MONITOR_R2_PREFIX=roz
EARNINGS_MONITOR_R2_ACCESS_KEY_ID=
EARNINGS_MONITOR_R2_SECRET_ACCESS_KEY=
EARNINGS_MONITOR_R2_MAX_ATTEMPTS=5

# AWS values are intentionally blank for local mode.
AWS_REGION=us-east-1
QUEUE_URL=
STATE_TABLE_NAME=
ARTIFACT_BUCKET_NAME=
APP_SECRET_ARN=
SES_IDENTITY_ARN=
